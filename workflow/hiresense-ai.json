ding:14px 32px;border-radius:8px;font-size:15px;font-weight:bold;display:inline-block;\">Join Interview</a>\n      </td>\n    </tr>\n\n    <!-- Note -->\n    <tr>\n      <td style=\"padding:0 32px 28px;color:#4b5563;font-size:14px;line-height:1.6;\">\n        <p style=\"margin:0;\">Please reply to this email to confirm your availability. If this time doesn't work, let us know and we'll reschedule.</p>\n      </td>\n    </tr>\n\n    <!-- Footer -->\n    <tr>\n      <td style=\"background:#f9fafb;padding:18px 32px;color:#6b7280;font-size:13px;border-top:1px solid #e5e7eb;\">\n        Regards,<br><b>HR Team</b>\n      </td>\n    </tr>\n  </table>\n</div>",
