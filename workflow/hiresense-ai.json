      "parameters": {
        "sendTo": "gangadevi2931@gmail.com",
        "subject": "=⚠️ Review Needed: {{ $('Resume Upload Form').item.json.Name }} for {{ $('Resume Upload Form').item.json.Role }} (Score {{ $json.output.match_score }}/100)",
        "message": "=<div style=\"background:#f4f6fb;padding:24px 0;font-family:Arial,Helvetica,sans-serif;\">\n  <table align=\"center\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e3e8f0;\">\n\n    <!-- Header -->\n    <tr>\n      <td style=\"background:#f59e0b;padding:28px 32px;\">\n        <h1 style=\"margin:0;color:#ffffff;font-size:22px;\">⚠️ Manual Review Needed</h1>\n        <p style=\"margin:6px 0 0;color:#fef3c7;font-size:14px;\">{{ $('Resume Upload Form').item.json.Role }} · Borderline candidate, please decide</p>\n      </td>\n    </tr>\n\n    <!-- Candidate summary -->\n    <tr>\n      <td style=\"padding:28px 32px 8px;color:#1f2937;font-size:15px;line-height:1.6;\">\n        <p style=\"margin:0;\">The AI screener marked this candidate as <b>Maybe</b> for the <b>{{ $('Resume Upload Form').item.json.Role }}</b> role. Please review the details below and decide.</p>\n      </td>\n    </tr>\n\n    <!-- Score + details card -->\n    <tr>\n      <td style=\"padding:16px 32px;\">\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fffbeb;border-left:4px solid #f59e0b;border-radius:8px;\">\n          <tr>\n            <td style=\"padding:16px 20px;color:#1f2937;font-size:14px;line-height:1.9;\">\n              👤 <b>Name:</b> {{ $('Resume Upload Form').item.json.Name }}<br>\n              📧 <b>Email:</b> {{ $('Resume Upload Form').item.json.Email }}<br>\n              📞 <b>Phone:</b> {{ $json.output.phone || 'Not found in resume' }}<br>\n              💼 <b>Applied Role:</b> {{ $('Resume Upload Form').item.json.Role }}<br>\n              🎓 <b>Education:</b> {{ $json.output.education }}<br>\n              ⏱️ <b>Experience:</b> {{ $json.output.years_experience }} years<br>\n              🛠️ <b>Skills:</b> {{ Array.isArray($json.output.skills) ? $json.output.skills.join(\", \") : $json.output.skills }}\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n\n    <!-- Score -->\n    <tr>\n      <td align=\"center\" style=\"padding:8px 32px 16px;\">\n        <div style=\"display:inline-block;background:#f59e0b;color:#ffffff;font-size:28px;font-weight:bold;padding:12px 28px;border-radius:10px;\">\n          {{ $json.output.match_score }} / 100\n        </div>\n        <p style=\"margin:8px 0 0;color:#6b7280;font-size:13px;\">Match score for {{ $('Resume Upload Form').item.json.Role }}</p>\n      </td>\n    </tr>\n\n    <!-- Strengths -->\n    <tr>\n      <td style=\"padding:0 32px 12px;\">\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ecfdf5;border-left:4px solid #10b981;border-radius:8px;\">\n          <tr>\n            <td style=\"padding:14px 20px;color:#065f46;font-size:14px;line-height:1.6;\">\n              <b>✅ Strengths</b><br>{{ $json.output.strengths }}\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n\n    <!-- Gaps -->\n    <tr>\n      <td style=\"padding:0 32px 24px;\">\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fef2f2;border-left:4px solid #ef4444;border-radius:8px;\">\n          <tr>\n            <td style=\"padding:14px 20px;color:#991b1b;font-size:14px;line-height:1.6;\">\n              <b>❌ Gaps</b><br>{{ $json.output.gaps }}\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n\n    <!-- Footer -->\n    <tr>\n      <td style=\"background:#f9fafb;padding:18px 32px;color:#6b7280;font-size:13px;border-top:1px solid #e5e7eb;\">\n        Auto-generated by HireSense AI\n      </td>\n    </tr>\n  </table>\n</div>",
